// OpenCode configuration template — reference only.
// scripts/configure.sh writes ~/.config/opencode/opencode.json from scratch;
// this file documents the options used. Full reference:
//   https://opencode.ai/docs/config
//
// Two endpoint options (configure.sh picks one based on which key is present):
//
// ── Option A: OU AI Sandbox (first choice when LITELLM_API_KEY is set) ───────
// {
//   "$schema": "https://opencode.ai/config.json",
//   "provider": {
//     "ou-sandbox": {
//       "npm": "@ai-sdk/openai-compatible",
//       "name": "OU AI Sandbox",
//       "options": {
//         "baseURL": "https://litellm.lib.ou.edu/v1",
//         "apiKey": "<LITELLM_API_KEY>"
//       },
//       "models": {
//         "Qwen3 Coder 30B": { "name": "Qwen3 Coder 30B" }
//       }
//     }
//   },
//   "model": "ou-sandbox/Qwen3 Coder 30B"
// }
//
// ── Option B: OpenRouter (your own key; used when no OU Sandbox key set) ─────
// {
//   "$schema": "https://opencode.ai/config.json",
//   "provider": {
//     "openrouter": {
//       "options": {
//         "apiKey": "<OPENROUTER_API_KEY>"
//       }
//     }
//   },
//   "model": "openrouter/qwen/qwen3-coder"
// }
//
// Both options accept any model available on the chosen endpoint.
// Switch at runtime: bash scripts/select-model.sh  (or Ctrl/Cmd+Alt+M)
