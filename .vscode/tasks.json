{
  // Auto-start (on folder open): OpenCode Chat (preflight + launch opencode).
  // On-demand (Command Palette → Tasks: Run Task): OpenCode: Choose Model.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenCode: Chat",
      "type": "shell",
      "command": "bash '${workspaceFolder}/scripts/start-opencode.sh'",
      "presentation": { "group": "opencode", "panel": "dedicated", "reveal": "always", "focus": true },
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": []
    },
    {
      "label": "OpenCode: Choose Model",
      "type": "shell",
      "command": "bash '${workspaceFolder}/scripts/select-model.sh'",
      "presentation": { "group": "opencode", "panel": "dedicated", "reveal": "always", "focus": true, "clear": true },
      "problemMatcher": []
    }
  ]
}
