{
  // Hermes Agent Codespace — auto-installs Hermes and points it at the first
  // working endpoint: OU AI Sandbox (if you have a key), else OpenRouter.
  // See scripts/preflight.sh + scripts/configure.sh. Comments are allowed here.
  "name": "Agentic Systems Course (OU AI Sandbox + OpenRouter)",

  // Node 22 LTS base — Hermes uses Python 3.11 (installed by its own installer)
  // plus a few Node utilities for tooling. Node 22.14+ is compatible.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",

  // Codespaces PROMPTS for these secrets at creation time if they aren't already
  // saved in the user's account/repo secrets. They are injected as env vars.
  "secrets": {
    "LITELLM_API_KEY": {
      "description": "FIRST CHOICE. Your OU AI Sandbox key (starts with sk-), issued by the course. If you have one, set it — the Codespace uses it automatically. Leave blank if you weren't issued one.",
      "documentationUrl": "https://hermes-agent.nousresearch.com/docs/integrations/providers"
    },
    "OPENROUTER_API_KEY": {
      "description": "Also works (used when no OU AI Sandbox key is set). Your OWN OpenRouter API key (starts with sk-or-). Create the account + key at https://openrouter.ai (Settings → Keys), load ~$10 of credit, and set a credit limit on the key. Expect at most ~$10 of usage for the term.",
      "documentationUrl": "https://openrouter.ai/docs/api-keys"
    }
  },

  // Runs once after the container is built: installs Hermes and writes config.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Runs on EVERY container start: runs a background preflight check so the
  // Hermes: Chat terminal can start faster. Idempotent and fully detached —
  // never blocks startup.
  "postStartCommand": "bash scripts/gateway-daemon.sh",

  "customizations": {
    "vscode": {
      // Machine-scoped settings applied inside the Codespace. This is the
      // supported place to allow folderOpen tasks — the same setting in
      // .vscode/settings.json (workspace scope) is IGNORED by VS Code for
      // security (a repo can't self-approve its own automatic tasks).
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  },

  "remoteUser": "node"
}
